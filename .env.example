PORT=3000
NODE_ENV=development
# Strong random string. If empty one is generated and stored in data/.jwt-secret
JWT_SECRET=
# Initial super admin (only used when the users table is empty).
# If ADMIN_PASSWORD is empty a random password is printed once in the console.
ADMIN_EMAIL=admin@gabrinell96.tl
ADMIN_PASSWORD=
# Set to true when served over HTTPS (adds Secure to the auth cookie)
COOKIE_SECURE=false
